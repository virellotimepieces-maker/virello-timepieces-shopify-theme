<section class="virello-product-extras"><div class="virello-product-extras__inner">
<div class="virello-product-extras__description"><div><p class="virello-product-extras__eyebrow">{{ 'virello.product.details' | t }}</p><h2>{{ 'virello.product.description' | t }}</h2></div><div class="virello-product-extras__richtext rte">{% if product.description != blank %}{{ product.description }}{% else %}<p>{{ 'virello.product.description_fallback' | t }}</p>{% endif %}</div></div>
<div class="virello-product-extras__benefits"><div class="virello-product-extras__intro"><p class="virello-product-extras__eyebrow">{{ 'virello.product.why_love_it' | t }}</p><h2>{{ 'virello.product.benefits_heading' | t }}</h2><p>{{ 'virello.product.benefits_intro' | t }}</p></div><div class="virello-product-extras__cards"><div><strong>{{ 'virello.product.feature_one_title' | t }}</strong><span>{{ 'virello.product.feature_one_text' | t }}</span></div><div><strong>{{ 'virello.product.feature_two_title' | t }}</strong><span>{{ 'virello.product.feature_two_text' | t }}</span></div><div><strong>{{ 'virello.product.feature_three_title' | t }}</strong><span>{{ 'virello.product.feature_three_text' | t }}</span></div></div></div>
{% if section.settings.show_faq %}<div class="virello-product-extras__faq"><p class="virello-product-extras__eyebrow">{{ 'virello.product.help' | t }}</p><h2>{{ 'virello.product.faq_heading' | t }}</h2><details><summary>{{ 'virello.product.faq_option_question' | t }}</summary><p>{{ 'virello.product.faq_option_answer' | t }}</p></details><details><summary>{{ 'virello.product.faq_shipping_question' | t }}</summary><p>{{ 'virello.product.faq_shipping_answer' | t }}</p></details><details><summary>{{ 'virello.product.faq_return_question' | t }}</summary><p>{{ 'virello.product.faq_return_answer' | t }}</p>{% if shop.refund_policy.url != blank %}<a href="{{ shop.refund_policy.url }}">{{ 'virello.product.read_return_policy' | t }}</a>{% endif %}</details></div>{% endif %}
</div></section>
{% stylesheet %}
.virello-product-extras{background:#fff;color:#151515}.virello-product-extras__inner{width:min(1180px,calc(100% - 48px));margin:0 auto;padding:12px 0 56px}.virello-product-extras__description,.virello-product-extras__benefits{display:grid;grid-template-columns:minmax(180px,.7fr) minmax(0,1.3fr);gap:clamp(28px,5vw,64px);border-top:1px solid #dedede;padding-top:34px;margin-top:34px}.virello-product-extras__eyebrow{margin:0 0 8px;color:#686868;font-size:.7rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase}.virello-product-extras h2{margin:0 0 12px;font-size:clamp(1.45rem,3vw,2rem);line-height:1.12}.virello-product-extras__richtext{color:#545454;font-size:.95rem;line-height:1.75}.virello-product-extras__richtext>*:first-child{margin-top:0}.virello-product-extras__richtext>*:last-child{margin-bottom:0}.virello-product-extras__intro>p:last-child{margin:0;color:#555;font-size:.95rem;line-height:1.6}.virello-product-extras__cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.virello-product-extras__cards div{padding:20px 16px;border:1px solid #dedede}.virello-product-extras__cards strong{display:block;font-size:.95rem}.virello-product-extras__cards span{display:block;margin-top:7px;color:#666;font-size:.85rem;line-height:1.55}.virello-product-extras__faq{border-top:1px solid #dedede;margin-top:42px;padding-top:34px}.virello-product-extras__faq details{border-top:1px solid #dedede;padding:16px 0}.virello-product-extras__faq details:last-child{border-bottom:1px solid #dedede}.virello-product-extras__faq summary{cursor:pointer;font-size:.95rem;font-weight:700}.virello-product-extras__faq details p{margin:10px 0 0;color:#626262;font-size:.9rem;line-height:1.6}.virello-product-extras__faq details a{display:inline-block;margin-top:8px;font-size:.9rem}@media screen and (max-width:749px){.virello-product-extras__inner{width:calc(100% - 40px);padding-bottom:40px}.virello-product-extras__description,.virello-product-extras__benefits{grid-template-columns:1fr;gap:18px;margin-top:24px;padding-top:26px}.virello-product-extras__cards{grid-template-columns:1fr;gap:10px}.virello-product-extras__cards div{padding:16px}.virello-product-extras__faq{margin-top:30px;padding-top:26px}}
{% endstylesheet %}
{% schema %}{"name":"Virello product features","settings":[{"type":"checkbox","id":"show_faq","label":"Show frequently asked questions","default":true}],"presets":[{"name":"Virello product features"}]}{% endschema %}
{% comment %}
  Product titles, descriptions, and media come from the Shopify catalog.
  This section does not claim that a watch is an authentic third-party luxury product.
  Replace any catalog item that uses another brand's name, model, or trademarks before publishing.
{% endcomment %}
<section class="virello-product-extras">
  <div class="virello-product-extras__inner">
    <div class="virello-product-extras__description">
      <div>
        <p class="virello-product-extras__eyebrow">{{ 'virello.product.details' | t }}</p>
        <h2>{{ 'virello.product.description' | t }}</h2>
      </div>
      <div class="virello-product-extras__richtext rte">
        {% if product.description != blank %}
          {{ product.description }}
        {% else %}
          <p>{{ 'virello.product.description_fallback' | t }}</p>
        {% endif %}
      </div>
    </div>

    <div class="virello-product-extras__benefits">
      <div class="virello-product-extras__intro">
        <p class="virello-product-extras__eyebrow">{{ 'virello.product.why_love_it' | t }}</p>
        <h2>{{ 'virello.product.benefits_heading' | t }}</h2>
        <p>{{ 'virello.product.benefits_intro' | t }}</p>
      </div>
      <div class="virello-product-extras__cards">
        <div>
          <strong>{{ 'virello.product.feature_one_title' | t }}</strong>
          <span>{{ 'virello.product.feature_one_text' | t }}</span>
        </div>
        <div>
          <strong>{{ 'virello.product.feature_two_title' | t }}</strong>
          <span>{{ 'virello.product.feature_two_text' | t }}</span>
        </div>
        <div>
          <strong>{{ 'virello.product.feature_three_title' | t }}</strong>
          <span>{{ 'virello.product.feature_three_text' | t }}</span>
        </div>
      </div>
    </div>

    {% if section.settings.show_faq %}
      <div class="virello-product-extras__faq">
        <p class="virello-product-extras__eyebrow">{{ 'virello.product.help' | t }}</p>
        <h2>{{ 'virello.product.faq_heading' | t }}</h2>
        <details>
          <summary>{{ 'virello.product.faq_option_question' | t }}</summary>
          <p>{{ 'virello.product.faq_option_answer' | t }}</p>
        </details>
        <details>
          <summary>{{ 'virello.product.faq_shipping_question' | t }}</summary>
          <p>{{ 'virello.product.faq_shipping_answer' | t }}</p>
        </details>
        <details>
          <summary>{{ 'virello.product.faq_return_question' | t }}</summary>
          <p>{{ 'virello.product.faq_return_answer' | t }}</p>
          {% if shop.refund_policy.url != blank %}
            <a href="{{ shop.refund_policy.url }}">{{ 'virello.product.read_return_policy' | t }}</a>
          {% endif %}
        </details>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Virello product features",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_faq",
      "label": "Show frequently asked questions",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Virello product features"
    }
  ]
}
{% endschema %}

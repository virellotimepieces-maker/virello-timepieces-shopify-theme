<section class="virello-editorial color-{{ section.settings.color_scheme }}">
  <div class="virello-editorial__inner">
    <div class="virello-editorial__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="virello-editorial__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p>{{ section.settings.text }}</p>
      {% endif %}
    </div>
    <ol class="virello-editorial__grid">
      {% for i in (1..3) %}
        {% liquid
          assign title_key = 'title_' | append: i
          assign text_key = 'text_' | append: i
          assign title = section.settings[title_key]
          assign text = section.settings[text_key]
        %}
        {% if title != blank or text != blank %}
          <li>
            <span>0{{ i }}</span>
            {% if title != blank %}
              <h3>{{ title }}</h3>
            {% endif %}
            {% if text != blank %}
              <p>{{ text }}</p>
            {% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Virello editorial",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A quieter way to shop watches."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Each piece is presented on its own terms. Read the product description for case, movement, and finishing before you order."
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "Card 1 title",
      "default": "Selected, not stacked"
    },
    {
      "type": "textarea",
      "id": "text_1",
      "label": "Card 1 text",
      "default": "The homepage shows a short edit. The full catalog stays in the collection."
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Card 2 title",
      "default": "Checkout you can trace"
    },
    {
      "type": "textarea",
      "id": "text_2",
      "label": "Card 2 text",
      "default": "Payment is handled by Shopify checkout. Shipping choices appear before you pay."
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "Card 3 title",
      "default": "Policies in writing"
    },
    {
      "type": "textarea",
      "id": "text_3",
      "label": "Card 3 text",
      "default": "Returns and support follow the store policies linked in the footer."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Virello editorial"
    }
  ]
}
{% endschema %}
